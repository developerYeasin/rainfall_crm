NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=88.222.241.192
DB_PORT=3306
DB_USER=mini_social_user
DB_PASSWORD=your_db_password
DB_NAME=rainfall_crm
DB_CONNECTION_LIMIT=10

JWT_ACCESS_SECRET=rainfall_access_secret_change_me
JWT_REFRESH_SECRET=rainfall_refresh_secret_change_me
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=30d

# Encrypts ad-account access tokens at rest (required in production)
CREDENTIALS_KEY=change_me_to_a_long_random_string

# Meta Marketing API — system-user token of the Business Partner account (per-account tokens override it)
META_API_VERSION=v21.0
META_ACCESS_TOKEN=

# Google Ads API — developer token + OAuth client of the agency, refresh token, and MCC id
GOOGLE_ADS_API_VERSION=v20
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# TikTok Business API — long-lived access token of the agency's Business Center app
TIKTOK_ACCESS_TOKEN=

# Background jobs: ad sync, invoice due reminders, overdue tasks
JOBS_ENABLED=true
AD_SYNC_INTERVAL_HOURS=3
APP_URL=http://localhost:5173

# Email for invoices / dues (optional — without SMTP_HOST mail is only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Rainfall Media <no-reply@rainfall.com>

SEED_ADMIN_EMAIL=admin@rainfall.com
SEED_ADMIN_PASSWORD=Admin@123
